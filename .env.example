# Базовый URL Yandex Direct API. По умолчанию — ПЕСОЧНИЦА (не бой!).
YANDEX_API_BASE=https://api-sandbox.direct.yandex.com/json/v5/

# Логин рекламодателя для агентских аккаунтов (заголовок Client-Login). Опционально.
YANDEX_CLIENT_LOGIN=

# ВНИМАНИЕ: OAuth-токен здесь НЕ хранится. Он вводится в приложении и шифруется
# через safeStorage (macOS Keychain). В .env токен не класть.
