# Базовый URL Yandex Direct API v5. По умолчанию — SANDBOX (не бей по бою!).
YANDEX_API_BASE=https://api-sandbox.direct.yandex.com/json/v5/

# Логин клиента Директа (Client-Login), под которым работает агентство/представитель.
# Для собственного аккаунта можно оставить пустым.
YANDEX_CLIENT_LOGIN=

# ВНИМАНИЕ: OAuth-токен здесь НЕ хранится. Он вводится в UI и шифруется через
# Electron safeStorage (macOS Keychain). В .env и любые файлы токен не попадает.
